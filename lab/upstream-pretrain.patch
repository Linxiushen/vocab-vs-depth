+class PackedSequenceDataset(Dataset):
+    """Reads padding-free, pre-packed training sequences (lab/pack_corpus.py, P1).
+
+    This is a minimal reader written from scratch for this patch, NOT an import of
+    lab/packed_dataset.py: that module belongs to a sibling task and its contract
+    can still change, whereas this patch must apply to and run against a clean
+    minimind checkout by itself. Duplicating ~15 lines here is cheaper than a
+    cross-repo dependency from inside the submodule out to lab/.
+
+    Expected files at ``prefix``:
+      <prefix>.ids.u16        memmap (n_seq, seq_len) uint16, no padding
+      <prefix>.bytes_cum.i64  memmap (n_seq,) int64, exact cumulative utf8 bytes of
+                              original text consumed through the end of sequence i
+      <prefix>.meta.json      {"n_seq": ..., "seq_len": ..., "vocab_size": ...}
+
+    __getitem__ returns the FULL seq_len ids as both input and label candidate
+    (labels are set to the same ids by the caller): MiniMindForCausalLM.forward
+    does logits[..., :-1] vs labels[..., 1:] internally (model_minimind.py ~L247),
+    so passing an already-shifted (x, y) pair here would shift twice.
+
+    bytes_delta is the exact count of original-text UTF-8 bytes this sequence
+    consumed, i.e. the bytes behind all seq_len of its tokens -- including the
+    first token, which is never a prediction target. So the ledger's
+    train_bits_per_byte divides by roughly 1/seq_len (0.2% at 512) more bytes than
+    it has targets for. Both arms use the same seq_len, so the bias is identical
+    on both sides of the comparison and the cross-arm delta stays symmetric; it is
+    written down here because neither the P2 contract nor 决策文档 §1.4(b) pins
+    the convention down, and eval-side BPB (lab/eval_bpb.py) does not share it.
+    """
+
+    def __init__(self, prefix):
+        meta_path = Path(f'{prefix}.meta.json')
+        ids_path = Path(f'{prefix}.ids.u16')
+        bytes_path = Path(f'{prefix}.bytes_cum.i64')
+        for path in (meta_path, ids_path, bytes_path):
+            if not path.is_file():
+                raise FileNotFoundError(f'packed file not found: {path}')
+        self.meta = json.loads(meta_path.read_text(encoding='utf-8'))
+        self.n_seq = int(self.meta['n_seq'])
+        self.seq_len = int(self.meta['seq_len'])
+        self.vocab_size = int(self.meta['vocab_size'])
+        if self.n_seq <= 0 or self.seq_len <= 0:
+            raise ValueError(f'invalid packed meta at {meta_path}: {self.meta}')
+        # np.memmap with an explicit shape only raises when the file is too SMALL
+        # for it; a file that is too LARGE is silently truncated to the shape. A
+        # stale meta.json (n_seq left over from an earlier, smaller pack) would
+        # therefore train on a silent prefix of the array whose bytes_cum no longer
+        # lines up, with no warning anywhere. Check both file sizes exactly.
+        actual_ids_bytes = ids_path.stat().st_size
+        expected_ids_bytes = self.n_seq * self.seq_len * 2
+        if actual_ids_bytes != expected_ids_bytes:
+            raise ValueError(
+                f'{ids_path} is {actual_ids_bytes} bytes, but {meta_path.name} says '
+                f'n_seq={self.n_seq} x seq_len={self.seq_len} x 2 = {expected_ids_bytes}: '
+                'stale meta.json, or a truncated / mismatched pack')
+        actual_cum_bytes = bytes_path.stat().st_size
+        expected_cum_bytes = self.n_seq * 8
+        if actual_cum_bytes != expected_cum_bytes:
+            raise ValueError(
+                f'{bytes_path} is {actual_cum_bytes} bytes, but n_seq={self.n_seq} x 8 = '
+                f'{expected_cum_bytes} was expected: stale meta.json, or a bad pack')
+        self.ids = np.memmap(ids_path, dtype=np.uint16, mode='r',
+                             shape=(self.n_seq, self.seq_len))
+        self.bytes_cum = np.memmap(bytes_path, dtype=np.int64, mode='r',
+                                   shape=(self.n_seq,))
+
+    def __len__(self):
+        return self.n_seq
+
+    def __getitem__(self, index):
+        if index < 0 or index >= self.n_seq:
+            raise IndexError(f'packed index {index} out of range [0, {self.n_seq})')
+        ids = torch.from_numpy(np.asarray(self.ids[index], dtype=np.int64))
+        prev = int(self.bytes_cum[index - 1]) if index > 0 else 0
+        bytes_delta = int(self.bytes_cum[index]) - prev
+        return ids, bytes_delta
+
 
