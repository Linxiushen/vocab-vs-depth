+def get_lr_wsd(step, total, lr, warmup_frac=0.02, decay_frac=0.10, floor=0.1):
+    """Warmup-stable-decay schedule (决策文档 §1.4(a), transcribed verbatim).
+
+    get_lr above is upstream's no-warmup cosine: at step 0 it already returns full
+    lr, which is unsafe straight out of random init (决策文档 §1.1, "加 warmup").
+    `total` must be the CALLING run's own total optimizer-update count -- each run
+    anneals fully to its own budget, never to a horizon shared across runs.
+    """
+    w, d = max(int(warmup_frac*total), 1), max(int(decay_frac*total), 1)
+    if step < w:         return lr*(step+1)/w
+    if step < total-d:   return lr
+    p = (step-(total-d))/d
+    return lr*(floor+(1-floor)*0.5*(1+math.cos(math.pi*p)))
+
+
+def flops_nominal_per_position(model, num_hidden_layers, hidden_size, seq_len):
+    """Nominal forward+backward FLOPs for one sequence position (决策文档 §1.4(b)).
+
+    6*N (Kaplan et al. 2020) approximates the matmul FLOPs of all N parameters,
+    counting a tied lm_head/embedding only once -- `model.parameters()` already
+    dedupes shared tensors by identity, so plain numel() summation is correct.
+    The + 12*L*H*S term is the additional attention cost, using a nominal context
+    length S (this run's seq_len) rather than each position's true, growing
+    context -- hence "nominal", not exact. Verified against the decision doc's
+    own two pinned figures: A (vocab 6400, 8 layers, hidden 768) = 421.2M/position,
+    B (vocab 16384, 7 layers, hidden 768) = 418.3M/position, both at seq_len=512.
+    """
+    n_params = sum(p.numel() for p in model.parameters())
+    return 6 * n_params + 12 * num_hidden_layers * hidden_size * seq_len
