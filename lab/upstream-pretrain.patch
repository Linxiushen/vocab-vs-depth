+def sha256_file(path):
+    """Same digest lab/common.py::sha256_file computes, re-implemented here.
+
+    The patch cannot import from lab/ (it has to apply to and run inside a clean
+    minimind checkout), and this is the only place the trainer needs a file hash:
+    proving the tokenizer it was handed is the exact one the packed ids were
+    written with.
+    """
+    digest = hashlib.sha256()
+    with open(path, 'rb') as stream:
+        for chunk in iter(lambda: stream.read(1 << 20), b''):
+            digest.update(chunk)
+    return digest.hexdigest()
+
