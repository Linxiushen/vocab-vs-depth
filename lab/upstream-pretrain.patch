+def train_packed(dataset, total_updates, tokens_per_update):
+    """Fixed-token-budget training loop over a padding-free packed dataset.
+
+    This intentionally does not reuse train_epoch above, because packed training
+    differs from it in every load-bearing way (决策文档 §1.3-1.5):
+      - stops at a token budget, not an epoch boundary. The caller has already
+        proven the packed corpus is large enough that this never repeats data;
+      - every one of the (seq_len-1) positions per sequence is a real supervised
+        target (packed sequences carry no padding), so there is no equivalent of
+        PretrainDataset's `labels[input_ids==pad_id]=-100` to apply;
+      - the LR schedule horizon is THIS run's own total_updates, either upstream's
+        no-warmup cosine or the WSD schedule of §1.4(a);
+      - it writes one lab/run_ledger.jsonl row per optimizer update (§1.4(b)).
+    """
+    targets_per_seq = dataset.seq_len - 1
+    if args.batch_size * targets_per_seq * args.accumulation_steps != tokens_per_update:
+        raise AssertionError('internal: tokens_per_update disagrees with batch/accumulation config')
+    flops_per_pos = flops_nominal_per_position(model, lm_config.num_hidden_layers,
+                                               lm_config.hidden_size, dataset.seq_len)
+    save_every = (max(1, math.ceil(args.save_steps_frac * total_updates))
+                 if args.save_steps_frac > 0 else total_updates)
+
+    ledger_path = None
+    if args.ledger:
+        ledger_path = Path(args.ledger)
+        ledger_path.parent.mkdir(parents=True, exist_ok=True)
+
+    seqs_needed = total_updates * args.batch_size * args.accumulation_steps
+    # Strictly sequential, deliberately NOT shuffled. pack_corpus.py already laid
+    # this stream out in the seed-42 doc_order that BOTH arms share (P1/D3), and
+    # 决策文档 §2.3 states "相同数据顺序" as a precondition of the main result.
+    # A torch.randperm(len(dataset)) here would draw from an arm-specific n_seq
+    # (1465 vs 1238 on a 4000-doc sample), so the same seed yields two unrelated
+    # permutations: at an equal-compute point the two arms would no longer be
+    # reading nested text but two disjoint random subsets, inflating sigma_d --
+    # the very quantity §2.3's MDE is built from. Sequential reading also keeps
+    # §2.1's R-byte lookup exact (bytes consumed == bytes_cum[seqs_consumed-1],
+    # asserted every update below) and keeps the 0.6-1.1 GB memmap a linear scan.
+    order = range(seqs_needed)
+
+    kept_checkpoints = []
+    seqs_consumed = tokens_cum = positions_cum = 0
+    text_targets_cum = structural_targets_cum = utf8_bytes_cum = 0
+    started = time.time()
+    cursor = 0
+    for update in range(1, total_updates + 1):
+        step0 = update - 1
+        if args.schedule == 'wsd':
+            lr = get_lr_wsd(step0, total_updates, args.learning_rate,
+                            args.warmup_frac, args.decay_frac, args.lr_floor)
+        else:
+            lr = get_lr(step0, total_updates, args.learning_rate)
+        for group in optimizer.param_groups:
+            group['lr'] = lr
+
+        update_nll = 0.0
+        update_targets = update_text_targets = update_structural_targets = 0
+        update_bytes = 0
+        for _ in range(args.accumulation_steps):
+            batch_idx = order[cursor:cursor + args.batch_size]
+            cursor += args.batch_size
+            items = [dataset[i] for i in batch_idx]
+            ids = torch.stack([item[0] for item in items]).to(args.device)
+            labels = ids  # model shifts internally; packed sequences have no padding to mask
+
+            with autocast_ctx:
+                res = model(ids, labels=labels)
+                loss = (res.loss + res.aux_loss) / args.accumulation_steps
+            scaler.scale(loss).backward()
+
+            n_targets = ids.shape[0] * targets_per_seq
+            struct = int(((labels[:, 1:] == lm_config.bos_token_id) |
+                         (labels[:, 1:] == lm_config.eos_token_id)).sum().item())
+            update_nll += res.loss.item() * n_targets
+            update_targets += n_targets
+            update_structural_targets += struct
+            update_text_targets += n_targets - struct
+            update_bytes += sum(item[1] for item in items)
+            seqs_consumed += ids.shape[0]
+            positions_cum += ids.shape[0] * dataset.seq_len
+
+        scaler.unscale_(optimizer)
+        grad_norm = torch.nn.utils.clip_grad_norm_(model.parameters(), args.grad_clip)
+        scaler.step(optimizer)
+        scaler.update()
+        optimizer.zero_grad(set_to_none=True)
+
+        tokens_cum += update_targets
+        text_targets_cum += update_text_targets
+        structural_targets_cum += update_structural_targets
+        utf8_bytes_cum += update_bytes
+        if int(dataset.bytes_cum[seqs_consumed - 1]) != utf8_bytes_cum:
+            raise AssertionError(
+                f'update {update}: consumed {utf8_bytes_cum} utf8 bytes, but '
+                f'bytes_cum[{seqs_consumed - 1}]={int(dataset.bytes_cum[seqs_consumed - 1])}. '
+                'The packed stream must be walked strictly in order: 决策文档 §2.1 reads '
+                "the R-byte budget straight off bytes_cum, and §2.3's equal-compute claim "
+                'assumes both arms walked the same documents in the same order.')
+        flops_nominal_cum = positions_cum * flops_per_pos
+        wall_seconds_cum = time.time() - started
+        loss_nats_per_target = update_nll / update_targets
+        if update_bytes <= 0:
+            raise ValueError(f'update {update}: batch utf8 byte count is {update_bytes}')
+        train_bits_per_byte = (loss_nats_per_target * update_targets /
+                               (math.log(2) * update_bytes))
+        grad_norm = float(grad_norm)
+
+        if update % args.log_interval == 0 or update == total_updates:
+            Logger(f'update [{update}/{total_updates}] lr={lr:.8f} '
+                  f'loss_nats_per_target={loss_nats_per_target:.4f} bpb={train_bits_per_byte:.4f} '
+                  f'grad_norm={grad_norm:.4f} tokens_cum={tokens_cum}/{int(args.total_tokens)}')
+
+        if ledger_path is not None:
+            row = {
+                "step": update, "seqs_consumed": seqs_consumed,
+                "tokens_cum": tokens_cum, "targets_cum": tokens_cum,
+                "text_targets_cum": text_targets_cum,
+                "structural_targets_cum": structural_targets_cum,
+                "positions_cum": positions_cum, "utf8_bytes_cum": utf8_bytes_cum,
+                "flops_nominal_cum": flops_nominal_cum, "wall_seconds_cum": wall_seconds_cum,
+                "lr": lr, "grad_norm": grad_norm,
+                "loss_nats_per_target": loss_nats_per_target,
+                "train_bits_per_byte": train_bits_per_byte,
+            }
+            with open(ledger_path, 'a', encoding='utf-8') as stream:
+                stream.write(json.dumps(row) + '\n')
+
+        if (update % save_every == 0 or update == total_updates) and is_main_process():
+            model.eval()
+            moe_suffix = '_moe' if lm_config.use_moe else ''
+            ckp = f'{args.save_dir}/{args.save_weight}_{lm_config.hidden_size}{moe_suffix}_step{update:07d}.pth'
+            raw_model = model.module if isinstance(model, DistributedDataParallel) else model
+            raw_model = getattr(raw_model, '_orig_mod', raw_model)
+            state_dict = raw_model.state_dict()
+            # Write-then-rename, like upstream's lm_checkpoint: a 20-36 h rented-GPU
+            # run killed in the middle of torch.save would otherwise leave a
+            # half-written .pth under a completely normal-looking name.
+            torch.save({k: v.half().cpu() for k, v in state_dict.items()}, ckp + '.tmp')
+            os.replace(ckp + '.tmp', ckp)
+            model.train()
+            del state_dict
+            # 137.7 MB per arm-A checkpoint: R-main (7,338 updates) at
+            # --save_steps_frac 0.05 is 21 files = 2.9 GB per run, ~58 GB over the
+            # 20 runs of 决策文档 §2.1. --keep_last_n caps that. Default 0 keeps
+            # everything, because §2.2 evaluates intermediate checkpoints to draw
+            # the curve -- deleting them by default would silently destroy data the
+            # experiment plans to use. The final checkpoint is never pruned.
+            if update != total_updates:
+                kept_checkpoints.append(ckp)
+                while args.keep_last_n > 0 and len(kept_checkpoints) > args.keep_last_n:
+                    os.remove(kept_checkpoints.pop(0))
+
+    if cursor != seqs_needed:
+        raise AssertionError('internal: packed sequence cursor did not match the planned consumption')
+
